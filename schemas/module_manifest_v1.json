{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bosscrafts.dev/schemas/module_manifest_v1.json",
  "title": "BossForgeOS Module Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "module_id",
    "display_name",
    "version",
    "standalone_entrypoint",
    "orchestrator_connector",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "standalone_entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "orchestrator_connector": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "health_endpoint": {
          "type": "string"
        },
        "event_channel": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}

