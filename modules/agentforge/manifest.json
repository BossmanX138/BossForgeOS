{
  "schema_version": "1.0",
  "module_id": "agentforge",
  "display_name": "AgentForge",
  "version": "0.1.0",
  "standalone_entrypoint": "python -m modules.agentforge.main",
  "orchestrator_connector": {
    "command": [
      "python",
      "-m",
      "modules.agentforge.connector"
    ],
    "health_endpoint": "http://127.0.0.1:5601/health",
    "event_channel": "agentforge.events"
  },
  "capabilities": [
    "agent.create",
    "agent.edit",
    "agent.profile",
    "agent.template"
  ],
  "notes": "Scaffold manifest for standalone + orchestrator-connected operation."
}

